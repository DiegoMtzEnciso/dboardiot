# Copia a .env.production (o .env.local en desarrollo). Vite expone solo las variables VITE_*.
# OJO: todo lo que lleva VITE_ queda visible en el navegador; no es un lugar para secretos reales.

# Broker MQTT por WebSocket seguro (wss://). Es el camino que llega al ESP32.
VITE_MQTT_URL=wss://test.mosquitto.org:8081
# Prefijo de los tópicos (debe coincidir con el firmware del ESP32)
VITE_MQTT_PREFIX=smartcare/petstation
# Solo si el broker exige usuario y clave
# VITE_MQTT_USER=
# VITE_MQTT_PASS=

# API REST de Node-RED. Vacío = no usarla (necesario en https si Node-RED no tiene https).
# En desarrollo local: http://10.6.29.51:1880
VITE_NODERED_URL=
